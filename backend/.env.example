# Vazir Chat Backend Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Google Gemini API Key for Dialog Management & Multimodal Audio
GEMINI_API_KEY=

# Default Uzbek Voice (uz-UZ-MadinaNeural or uz-UZ-SardorNeural)
DEFAULT_TTS_VOICE=uz-UZ-MadinaNeural

# Audio cache folder
AUDIO_CACHE_DIR=./cache/audio
